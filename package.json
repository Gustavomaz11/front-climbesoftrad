{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "dev:sourad": "node --use-system-ca node_modules/vite/bin/vite.js --mode sourad --port 5173 --strictPort",
    "dev:hospital": "node --use-system-ca node_modules/vite/bin/vite.js --mode hospital --port 5174 --strictPort",
    "dev:configuracoes": "node --use-system-ca node_modules/vite/bin/vite.js --mode configuracoes --port 5175 --strictPort",
    "build:sourad": "tsc -b && vite build --mode sourad",
    "build:hospital": "tsc -b && vite build --mode hospital",
    "build:configuracoes": "tsc -b && vite build --mode configuracoes",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-color": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-text-align": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "dicom-parser": "^1.8.21",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
